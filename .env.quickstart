# This file is documentation only. Run ./scripts/install.sh to generate .env.
GATEWAY_PORT=8767
GATEWAY_BIND_HOST=127.0.0.1
SEARXNG_PORT=8768
PROXY_API_KEY=generated-by-installer
SEARXNG_SECRET=generated-by-installer

# Host paths are detected by the installer and converted to absolute paths.
KIRO_AWS_CACHE_DIR=/Users/you/.aws/sso/cache
KIRO_CLI_DIR=/Users/you/.local/share/kiro-cli
KIRO_CREDS_FILE_CONTAINER=/home/kiro/.aws/sso/cache/kiro-auth-token.json
KIRO_CLI_DB_FILE_CONTAINER=
PROFILE_ARN=

# Optional for users whose local VPN listens on 127.0.0.1:8118.
# Inside Docker, use host.docker.internal rather than 127.0.0.1.
VPN_PROXY_URL=http://host.docker.internal:8118
